{
  "name": "@elysium/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./courier": {
      "types": "./dist/courier/index.d.ts",
      "default": "./dist/courier/index.js"
    },
    "./payroll": {
      "types": "./dist/payroll/index.d.ts",
      "default": "./dist/payroll/index.js"
    },
    "./investors": {
      "types": "./dist/investors/index.d.ts",
      "default": "./dist/investors/index.js"
    },
    "./posting/investors": {
      "types": "./dist/posting/investors.d.ts",
      "default": "./dist/posting/investors.js"
    },
    "./pos": {
      "types": "./dist/pos/index.d.ts",
      "default": "./dist/pos/index.js"
    },
    "./posting/pos": {
      "types": "./dist/posting/pos.d.ts",
      "default": "./dist/posting/pos.js"
    },
    "./promo": {
      "types": "./dist/promo/index.d.ts",
      "default": "./dist/promo/index.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "default": "./dist/notify/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "@elysium/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
