{
  "name": "@elysium/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "default": "./dist/locales/en.js"
    },
    "./locales/bn": {
      "types": "./dist/locales/bn.d.ts",
      "default": "./dist/locales/bn.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@elysium/domain": "workspace:*"
  },
  "devDependencies": {
    "@elysium/config": "workspace:*",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
