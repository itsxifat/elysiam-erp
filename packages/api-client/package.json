{
  "name": "@elysium/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "node scripts/generate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@elysium/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@elysium/contracts": "workspace:*"
  }
}
