{
  "name": "@elysium/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "node -e \"console.error('api:client - nothing to generate yet. M04 emits OpenAPI from packages/contracts and regenerates this client, with a CI drift check.'); process.exit(1)\"",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@elysium/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
