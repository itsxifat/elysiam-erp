{
  "name": "elysium-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.13.0 <25.0.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint -- --fix && eslint . --fix",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @elysium/console run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:migrations": "node scripts/check-migrations.mjs",
    "bench": "node scripts/bench.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "db:generate": "pnpm --filter @elysium/db run db:generate",
    "db:migrate": "pnpm --filter @elysium/db run db:migrate",
    "db:seed": "pnpm --filter @elysium/db run db:seed",
    "api:client": "pnpm --filter @elysium/api-client run generate",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:migrations",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@elysium/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
