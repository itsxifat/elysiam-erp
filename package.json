{
  "name": "elysium-erp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.13.0 <25.0.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "admin:bootstrap": "pnpm --filter @elysium/server run admin:bootstrap",
    "api:client": "pnpm --filter @elysium/api-client run generate",
    "bench": "node scripts/bench.mjs",
    "build": "turbo run build",
    "check:api-client": "node scripts/check-api-client.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:routes": "node scripts/check-route-matrix.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "clean": "turbo run clean",
    "db:bootstrap": "pnpm --filter @elysium/db run db:bootstrap",
    "db:generate": "pnpm --filter @elysium/db run db:generate",
    "db:migrate": "pnpm --filter @elysium/db run db:migrate",
    "db:seed": "pnpm --filter @elysium/db run db:seed",
    "dev": "turbo run dev",
    "e2e": "pnpm --filter @elysium/console run e2e",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint -- --fix && eslint . --fix",
    "load:test": "node scripts/load-test.mjs",
    "migration": "pnpm --filter @elysium/server run migration",
    "report:routes": "node scripts/route-report.mjs",
    "demo:org": "pnpm --filter @elysium/server run demo:org",
    "preview:local": "node scripts/preview-local.mjs",
    "preview:seed": "pnpm --filter @elysium/server run preview:seed",
    "setup:env": "node scripts/setup-env.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:bundle && pnpm run check:migrations && pnpm run check:schema && pnpm run check:routes && pnpm run check:i18n && pnpm run check:api-client",
    "db:dev-users": "pnpm --filter @elysium/db run db:dev-users"
  },
  "devDependencies": {
    "@elysium/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
