# The single-server preview's settings (infra/docker-compose.preview.yml, D-352).
#
# Do not edit this file. On the server, `sh infra/preview/init-env.sh <domain>` copies it to
# a gitignored .env.preview readable by its owner only, and fills every secret below with a
# fresh random value. infra/preview/deploy.sh does that on the first deploy.
# docs/runbooks/preview-server.md explains each line.

# The one hostname the console, portal, till and API share, and its public URL. The host's
# nginx serves it, with certbot's certificate.
PREVIEW_DOMAIN=
PREVIEW_PUBLIC_URL=

# The loopback port the API is published on for nginx (127.0.0.1 only).
PREVIEW_API_PORT=3410

# Secrets: generated by init-env.sh. Never commit them, never paste them anywhere.
PREVIEW_DB_ROOT_PASSWORD=
PREVIEW_DB_OWNER_PASSWORD=
PREVIEW_DB_APP_PASSWORD=
PREVIEW_DB_ANALYTICS_PASSWORD=
PREVIEW_VALKEY_PASSWORD=
PREVIEW_AUTH_SECRET=
PREVIEW_HR_FIELD_KEY=
PREVIEW_COURIER_CREDENTIALS_KEY=
PREVIEW_MARKETING_CREDENTIALS_KEY=
# The website's SSLCommerz and email passwords (M34, D-528).
PREVIEW_STOREFRONT_CREDENTIALS_KEY=
PREVIEW_INTAKE_KEY_SECRET=

# Files: `local` keeps uploads on the server's `files` volume, served through the API.
# For R2, set `r2`, the four values below and PREVIEW_CSP_CONNECT_SRC, which lets the SPAs
# upload to R2 (it goes into their CSP when server-deploy.sh builds them).
PREVIEW_STORAGE_DRIVER=local
PREVIEW_R2_ACCOUNT_ID=
PREVIEW_R2_BUCKET=
PREVIEW_R2_ACCESS_KEY_ID=
PREVIEW_R2_SECRET_ACCESS_KEY=
PREVIEW_CSP_CONNECT_SRC=

# Optional error reporting (D-344). Empty means off.
PREVIEW_SENTRY_DSN=
