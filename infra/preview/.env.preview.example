# The single-server preview's settings (infra/docker-compose.preview.yml, D-352).
#
# Do not edit this file. Run `sh infra/preview/init-env.sh <domain or IP>`: it copies this
# to infra/preview/.env.preview (gitignored, readable by its owner only) and fills every
# secret below with a fresh random value. Then edit .env.preview if you need to.
# docs/runbooks/preview-server.md explains each line.

# The parent domain. Caddy serves api., console., portal., pos. and the five brand
# hostnames under it, each with HTTPS. Point a wildcard DNS record (*.<domain>) at the
# server. With no domain, init-env.sh turns the server's IP into <ip-with-dashes>.sslip.io.
PREVIEW_DOMAIN=

# Empty: certificates from Let's Encrypt (needs ports 80 and 443 reachable from the
# internet). `local_certs`: Caddy's own authority, for a server the internet cannot reach;
# browsers will warn.
PREVIEW_LOCAL_CERTS=

# Host ports Caddy listens on. Keep 80 and 443 for Let's Encrypt.
PREVIEW_HTTP_PORT=80
PREVIEW_HTTPS_PORT=443

# Secrets: generated by init-env.sh. Never commit them.
PREVIEW_DB_ROOT_PASSWORD=
PREVIEW_DB_OWNER_PASSWORD=
PREVIEW_DB_APP_PASSWORD=
PREVIEW_DB_ANALYTICS_PASSWORD=
PREVIEW_VALKEY_PASSWORD=
PREVIEW_AUTH_SECRET=
PREVIEW_HR_FIELD_KEY=
PREVIEW_COURIER_CREDENTIALS_KEY=
PREVIEW_MARKETING_CREDENTIALS_KEY=
PREVIEW_INTAKE_KEY_SECRET=

# Files: `local` keeps uploads on the server's `files` volume. For R2, set `r2`, the four
# values below, and PREVIEW_CSP_CONNECT_SRC=https://<account-id>.r2.cloudflarestorage.com.
PREVIEW_STORAGE_DRIVER=local
PREVIEW_R2_ACCOUNT_ID=
PREVIEW_R2_BUCKET=
PREVIEW_R2_ACCESS_KEY_ID=
PREVIEW_R2_SECRET_ACCESS_KEY=
PREVIEW_CSP_CONNECT_SRC=

# Optional error reporting (D-344). Empty means off.
PREVIEW_SENTRY_DSN=
