# One brand's ERP settings (infra/brand/docker-compose.brand.yml, D-474).
#
# Do not edit this file. On the brands server, `sh infra/brand/new-brand.sh <slug> <admin-host>`
# copies it to <brands dir>/<slug>/.env.brand, readable by its owner only, and fills every
# secret below with a fresh random value. docs/runbooks/brand-deploy.md explains each line.

# The brand, by its seed slug (packages/db/src/seed/orgs.ts), and the host its staff use:
# admin.<the brand's domain> by default (D-475). The console, portal, till and API share it.
BRAND_SLUG=
BRAND_ADMIN_HOST=

# The loopback port the API is published on for nginx (127.0.0.1 only), one per brand.
BRAND_API_PORT=

# `true` when the admin host is proxied by Cloudflare (orange cloud): nginx then takes the
# visitor's address from CF-Connecting-IP, from Cloudflare's ranges only. Read when the brand's
# nginx site is first installed.
BRAND_BEHIND_CLOUDFLARE=false

# Secrets: generated by new-brand.sh. Never commit them, never paste them anywhere.
BRAND_DB_ROOT_PASSWORD=
BRAND_DB_OWNER_PASSWORD=
BRAND_DB_APP_PASSWORD=
BRAND_DB_ANALYTICS_PASSWORD=
BRAND_VALKEY_PASSWORD=
BRAND_AUTH_SECRET=
BRAND_HR_FIELD_KEY=
BRAND_COURIER_CREDENTIALS_KEY=
BRAND_MARKETING_CREDENTIALS_KEY=
# The website's SSLCommerz and email passwords (M34, D-528). A brand made before M34 adds
# one with `openssl rand -base64 32`; changing it means typing both passwords again.
BRAND_STOREFRONT_CREDENTIALS_KEY=
BRAND_INTAKE_KEY_SECRET=

# The owner sign-in link's public key (D-473): base64 of an Ed25519 public key in SPKI DER,
# given by whoever holds the private half. Empty keeps owner links off.
OWNER_LINK_PUBLIC_KEY=

# The owner console's read (M32, D-482): a loopback port to publish this brand's Postgres on,
# for its tunnel account's permitopen, one per brand (5541, 5542, ...). Empty publishes none.
BRAND_REPORTING_DB_PORT=

# Files: `local` keeps uploads on the brand's own `files` volume, served through its API.
# For R2, set `r2`, the four values below and BRAND_CSP_CONNECT_SRC (the R2 upload endpoint,
# which goes into the SPAs' CSP when server-deploy.sh builds them).
BRAND_STORAGE_DRIVER=local
BRAND_R2_ACCOUNT_ID=
BRAND_R2_BUCKET=
BRAND_R2_ACCESS_KEY_ID=
BRAND_R2_SECRET_ACCESS_KEY=
BRAND_CSP_CONNECT_SRC=

# The web phone through Envo (M47, D-844), in the console's CSP. Empty keeps the defaults, the
# owner's Envo: its script and session from https://envo.enfinito.cloud and its SIP WebSocket on
# wss://call.enfinito.cloud (Envo's SIP domain, a host of its own). A value replaces the
# default, so list every host, space-separated, no quotes. Settings -> Calls' base URL must be
# one of the ORIGINS and Envo's SIP domain one of the SOCKETS, or the phone says it is blocked.
BRAND_CSP_TELEPHONY_ORIGINS=
BRAND_CSP_TELEPHONY_SOCKETS=
# `fake` answers from memory, for a demo brand with no SIP server (nothing rings).
BRAND_TELEPHONY_ENVO_PROVIDER=http
# A connection's base URL that resolves to a private address is refused (D-830). If the API
# container resolves the brand's Envo to a LAN address (`getent hosts envo.enfinito.cloud` in the
# api container), list it here, e.g. 192.168.20.237/32. Empty refuses every private address.
BRAND_TELEPHONY_ENVO_PRIVATE_CIDRS=

# Optional error reporting (D-344). Empty means off.
BRAND_SENTRY_DSN=
