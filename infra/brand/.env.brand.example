# One brand's ERP settings (infra/brand/docker-compose.brand.yml, D-474).
#
# Do not edit this file. On the brands server, `sh infra/brand/new-brand.sh <slug> <admin-host>`
# copies it to <brands dir>/<slug>/.env.brand, readable by its owner only, and fills every
# secret below with a fresh random value. docs/runbooks/brand-deploy.md explains each line.

# The brand, by its seed slug (packages/db/src/seed/orgs.ts), and the host its staff use:
# admin.<the brand's domain> by default (D-475). The console, portal, till and API share it.
BRAND_SLUG=
BRAND_ADMIN_HOST=

# The loopback port the API is published on for nginx (127.0.0.1 only), one per brand.
BRAND_API_PORT=

# Secrets: generated by new-brand.sh. Never commit them, never paste them anywhere.
BRAND_DB_ROOT_PASSWORD=
BRAND_DB_OWNER_PASSWORD=
BRAND_DB_APP_PASSWORD=
BRAND_DB_ANALYTICS_PASSWORD=
BRAND_VALKEY_PASSWORD=
BRAND_AUTH_SECRET=
BRAND_HR_FIELD_KEY=
BRAND_COURIER_CREDENTIALS_KEY=
BRAND_MARKETING_CREDENTIALS_KEY=
BRAND_INTAKE_KEY_SECRET=

# The owner sign-in link's public key (D-473): base64 of an Ed25519 public key in SPKI DER,
# given by whoever holds the private half. Empty keeps owner links off.
OWNER_LINK_PUBLIC_KEY=

# Files: `local` keeps uploads on the brand's own `files` volume, served through its API.
# For R2, set `r2`, the four values below and BRAND_CSP_CONNECT_SRC (the R2 upload endpoint,
# which goes into the SPAs' CSP when server-deploy.sh builds them).
BRAND_STORAGE_DRIVER=local
BRAND_R2_ACCOUNT_ID=
BRAND_R2_BUCKET=
BRAND_R2_ACCESS_KEY_ID=
BRAND_R2_SECRET_ACCESS_KEY=
BRAND_CSP_CONNECT_SRC=

# Optional error reporting (D-344). Empty means off.
BRAND_SENTRY_DSN=
