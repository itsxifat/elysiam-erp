# Kamal secrets shared by every destination (dotenv format; kamal-deploy.org/docs/commands/secrets).
#
# REFERENCES ONLY. Never write a value into this file (§25, invariant 10). Each line reads
# the value from the deploying operator's environment, which their secret manager fills.
# To read from the manager directly instead, replace a line with Kamal's adapter, e.g.:
#
#   SECRETS=$(kamal secrets fetch --adapter 1password --account <account> --from <vault>/<item> KAMAL_REGISTRY_PASSWORD)
#   KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})

# A token that can push and pull the image (GitHub: a fine-grained token, packages read/write).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
