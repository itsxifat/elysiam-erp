# Kamal secrets for production (dotenv format), read with `-d production` after secrets-common.
#
# REFERENCES ONLY. Never write a value into this file (§25, invariant 10). Each value comes
# from the operator's environment, filled by the secret manager under a PRODUCTION_ prefix so a
# shell holding both environments cannot cross them. docs/runbooks/deploy.md lists how each
# is made; docs/runbooks/secret-rotation.md how each is changed.

# The three database roles (§5). The owner URL reaches the worker role only.
DATABASE_URL=$PRODUCTION_DATABASE_URL
DATABASE_OWNER_URL=$PRODUCTION_DATABASE_OWNER_URL
DATABASE_ANALYTICS_URL=$PRODUCTION_DATABASE_ANALYTICS_URL

# Valkey: the password, and the URL that carries it (redis://:<password>@<web private ip>:6379).
VALKEY_PASSWORD=$PRODUCTION_VALKEY_PASSWORD
VALKEY_URL=$PRODUCTION_VALKEY_URL

# Signing and field encryption keys (32 bytes of base64 each, except AUTH_SECRET: 32+ characters).
AUTH_SECRET=$PRODUCTION_AUTH_SECRET
HR_FIELD_KEY=$PRODUCTION_HR_FIELD_KEY
COURIER_CREDENTIALS_KEY=$PRODUCTION_COURIER_CREDENTIALS_KEY
MARKETING_CREDENTIALS_KEY=$PRODUCTION_MARKETING_CREDENTIALS_KEY
INTAKE_KEY_SECRET=$PRODUCTION_INTAKE_KEY_SECRET
TURNSTILE_SECRET_KEY=$PRODUCTION_TURNSTILE_SECRET_KEY

# Cloudflare R2 (§22): an API token scoped to this environment's bucket.
R2_ACCOUNT_ID=$PRODUCTION_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$PRODUCTION_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$PRODUCTION_R2_SECRET_ACCESS_KEY

# The Cloudflare Origin CA certificate and key kamal-proxy presents (D-343).
CLOUDFLARE_ORIGIN_CERT_PEM=$PRODUCTION_CLOUDFLARE_ORIGIN_CERT_PEM
CLOUDFLARE_ORIGIN_KEY_PEM=$PRODUCTION_CLOUDFLARE_ORIGIN_KEY_PEM

# Optional; an empty value is read as off (D-344).
SENTRY_DSN=$PRODUCTION_SENTRY_DSN
OTEL_EXPORTER_OTLP_HEADERS=$PRODUCTION_OTEL_EXPORTER_OTLP_HEADERS
