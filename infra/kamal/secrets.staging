# Kamal secrets for staging (dotenv format), read with `-d staging` after secrets-common.
#
# REFERENCES ONLY. Never write a value into this file (§25, invariant 10). Each value comes
# from the operator's environment, filled by the secret manager under a STAGING_ prefix so a
# shell holding both environments cannot cross them. docs/runbooks/deploy.md lists how each
# is made; docs/runbooks/secret-rotation.md how each is changed.

# The three database roles (§5). The owner URL reaches the worker role only.
DATABASE_URL=$STAGING_DATABASE_URL
DATABASE_OWNER_URL=$STAGING_DATABASE_OWNER_URL
DATABASE_ANALYTICS_URL=$STAGING_DATABASE_ANALYTICS_URL

# Valkey: the password, and the URL that carries it (redis://:<password>@<web private ip>:6379).
VALKEY_PASSWORD=$STAGING_VALKEY_PASSWORD
VALKEY_URL=$STAGING_VALKEY_URL

# Signing and field encryption keys (32 bytes of base64 each, except AUTH_SECRET: 32+ characters).
AUTH_SECRET=$STAGING_AUTH_SECRET
HR_FIELD_KEY=$STAGING_HR_FIELD_KEY
COURIER_CREDENTIALS_KEY=$STAGING_COURIER_CREDENTIALS_KEY
MARKETING_CREDENTIALS_KEY=$STAGING_MARKETING_CREDENTIALS_KEY
INTAKE_KEY_SECRET=$STAGING_INTAKE_KEY_SECRET
TURNSTILE_SECRET_KEY=$STAGING_TURNSTILE_SECRET_KEY

# Cloudflare R2 (§22): an API token scoped to this environment's bucket.
R2_ACCOUNT_ID=$STAGING_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$STAGING_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$STAGING_R2_SECRET_ACCESS_KEY

# The Cloudflare Origin CA certificate and key kamal-proxy presents (D-343).
CLOUDFLARE_ORIGIN_CERT_PEM=$STAGING_CLOUDFLARE_ORIGIN_CERT_PEM
CLOUDFLARE_ORIGIN_KEY_PEM=$STAGING_CLOUDFLARE_ORIGIN_KEY_PEM

# Optional; an empty value is read as off (D-344).
SENTRY_DSN=$STAGING_SENTRY_DSN
OTEL_EXPORTER_OTLP_HEADERS=$STAGING_OTEL_EXPORTER_OTLP_HEADERS
