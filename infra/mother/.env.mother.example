# The owner console's settings (M32). new-env.sh copies this to .env.mother with fresh
# secrets; never commit the copy.

# The owner console's own domain, e.g. owner.example.com. Nothing else is served on it.
MOTHER_DOMAIN=
MOTHER_PUBLIC_URL=

MOTHER_DB_ROOT_PASSWORD=
MOTHER_DB_OWNER_PASSWORD=
MOTHER_DB_APP_PASSWORD=
MOTHER_AUTH_SECRET=
# 32 bytes of base64. It seals every brand's read connection and owner-link key (D-481).
# Losing it means re-entering every connection and replacing every key: keep a copy apart
# from the database backups.
MOTHER_SECRETS_KEY=
MOTHER_SECRETS_KEY_ID=k1

# Where the host's nginx reaches the API.
MOTHER_API_PORT=3330

# The brands' server and the tunnel's forwards (D-482): "<listen>:<brand port>" pairs, one
# per brand, where <brand port> is that brand's BRAND_REPORTING_DB_PORT on the brands
# server. A brand's read connection, entered once in Settings -> Brands, is then
#   postgres://erp_analytics:<its BRAND_DB_ANALYTICS_PASSWORD>@tunnel:<listen>/erp
MOTHER_TUNNEL_HOST=
MOTHER_TUNNEL_USER=mother-tunnel
MOTHER_TUNNEL_FORWARDS=6541:5541 6542:5542 6543:5543 6544:5544 6545:5545
