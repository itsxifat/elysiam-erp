{
  "extends": "@elysium/config/tsconfig/react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "plugins": [
      {
        "name": "next",
      },
    ],
    "paths": {
      "@/*": ["./src/*"],
    },
    "types": ["node"],
  },
  "include": ["next-env.d.ts", "src/**/*", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"],
}
