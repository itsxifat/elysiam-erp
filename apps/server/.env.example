# Copy to .env (`pnpm setup:env` does this for every app).
# Secrets never go in this file; it lists names and safe local defaults only.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3000

# Matches infra/docker-compose.dev.yml.
DATABASE_URL=postgres://erp_owner:erp_dev_password@localhost:5432/elysium_dev
