# Copy to .env (`pnpm setup:env` does this for every app).
# Secrets never go in this file; it lists names and safe local defaults only.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3000

# Where browsers actually reach this API. API_HOST is a bind address and cannot
# stand in for it — in production that is 0.0.0.0.
API_PUBLIC_URL=http://localhost:3000

# Four roles, four privilege levels (architecture §5, D-042). They are not
# interchangeable: the app must never connect as the owner, and erp_owner is
# deliberately NOT a superuser, because a superuser bypasses FORCE RLS and every
# tenant isolation policy with it.
#
# Passwords here are local development values. Production secrets come from the
# secret manager. Run `pnpm db:bootstrap` once to create the roles.

# erp_app — the running API and worker. Subject to every RLS policy.
DATABASE_URL=postgres://erp_app:erp_app_dev_password@localhost:5432/elysium_dev

# erp_owner — migrations and seeds only.
DATABASE_OWNER_URL=postgres://erp_owner:erp_owner_dev_password@localhost:5432/elysium_dev

# erp_analytics — cross-org reads for the analytics module. Cannot write.
DATABASE_ANALYTICS_URL=postgres://erp_analytics:erp_analytics_dev_password@localhost:5432/elysium_dev

# Superuser. Used by `pnpm db:bootstrap` and nothing else.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_password@localhost:5432/elysium_dev

# Session and CSRF cookies are scoped to this domain so the console keeps its
# session inside the Chatwoot iframe, and branded login reads the org label off
# the subdomain: oura-lifestyle.localhost resolves to the Oura org (D-035).
# Branded login (D-035) gives each brand its own hostname, and the session and
# CSRF cookies are scoped to this parent domain so those hostnames share them
# (D-053). Chrome rejects `Domain=localhost`, so plain `localhost` cannot carry
# a cookie to `oura-lifestyle.localhost` and branded login cannot be exercised
# locally on it. To try branded login in development, use a dotted domain:
# either `lvh.me` (public DNS, resolves to 127.0.0.1) or a hosts-file entry for
# `erp.local` and `<brand>.erp.local`, and set APP_DOMAIN to it.
APP_DOMAIN=localhost

# Signs sessions and tokens. A development value; production comes from the
# secret manager and is never committed (§25).
AUTH_SECRET=dev-only-secret-at-least-32-characters-long

# Anything not listed here is refused by CSRF and by Better Auth.
# Reverse proxies in front of this process, for x-forwarded-for. 0 locally.
TRUSTED_PROXY_COUNT=0

TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# The largest single cash-in, in integer poisha (D-092). Default ৳1 crore.
# LEDGER_CASH_IN_MAX_POISHA=1000000000
