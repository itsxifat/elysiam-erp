# Copy to .env (`pnpm setup:env` does this for every app).
# Secrets never go in this file; it lists names and safe local defaults only.

NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=3000

# Where browsers actually reach this API. API_HOST is a bind address and cannot
# stand in for it — in production that is 0.0.0.0.
API_PUBLIC_URL=http://localhost:3000

# Four roles, four privilege levels (architecture §5, D-042). They are not
# interchangeable: the app must never connect as the owner, and erp_owner is
# deliberately NOT a superuser, because a superuser bypasses FORCE RLS and every
# tenant isolation policy with it.
#
# Passwords here are local development values. Production secrets come from the
# secret manager. Run `pnpm db:bootstrap` once to create the roles.

# erp_app — the running API and worker. Subject to every RLS policy.
DATABASE_URL=postgres://erp_app:erp_app_dev_password@localhost:5432/elysium_dev

# erp_owner — migrations and seeds only.
DATABASE_OWNER_URL=postgres://erp_owner:erp_owner_dev_password@localhost:5432/elysium_dev

# erp_analytics — cross-org reads for the analytics module. Cannot write.
DATABASE_ANALYTICS_URL=postgres://erp_analytics:erp_analytics_dev_password@localhost:5432/elysium_dev

# Superuser. Used by `pnpm db:bootstrap` and nothing else.
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_password@localhost:5432/elysium_dev

# Session and CSRF cookies are scoped to this domain so the console keeps its
# session inside the Chatwoot iframe, and branded login reads the org label off
# the subdomain: oura-lifestyle.localhost resolves to the Oura org (D-035).
# Branded login (D-035) gives each brand its own hostname, and the session and
# CSRF cookies are scoped to this parent domain so those hostnames share them
# (D-053). Chrome rejects `Domain=localhost`, so plain `localhost` cannot carry
# a cookie to `oura-lifestyle.localhost` and branded login cannot be exercised
# locally on it. To try branded login in development, use a dotted domain:
# either `lvh.me` (public DNS, resolves to 127.0.0.1) or a hosts-file entry for
# `erp.local` and `<brand>.erp.local`, and set APP_DOMAIN to it.
APP_DOMAIN=localhost

# Signs sessions and tokens. A development value; production comes from the
# secret manager and is never committed (§25).
AUTH_SECRET=dev-only-secret-at-least-32-characters-long

# Anything not listed here is refused by CSRF and by Better Auth.
# Reverse proxies in front of this process, for x-forwarded-for. 0 locally.
TRUSTED_PROXY_COUNT=0

TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# The largest single cash-in, in integer poisha (D-092). Default ৳1 crore.
# LEDGER_CASH_IN_MAX_POISHA=1000000000

# Encrypts the three personal fields on hr.employees — the payout account number, the
# national ID and the phone (M19, architecture §12, invariant 10). 32 bytes of base64.
#
# Optional, and derived from AUTH_SECRET when absent, so a developer needs nothing. Set
# it in production, for two reasons: rotating session signing should not mean
# re-encrypting every employee row, and leaking AUTH_SECRET should not leak personal
# data. Rotating it means re-encrypting the existing rows — the envelope carries a
# version byte so both keys can be read during the change.
#
# Generate one with: openssl rand -base64 32
# HR_FIELD_KEY=

# --- M12: couriers (architecture §21, §25) -----------------------------------------
#
# Encrypts every courier account's API credentials and webhook secret. 32 bytes of
# base64. Optional: a development machine and the route-coverage gate both boot with no
# courier configured, and the `fake` adapter needs no credentials. What is *not* optional
# is storing a real credential without it — `credentialCipher()` refuses with this
# variable's name in the message rather than writing plaintext into a bytea column and
# looking fine.
#
# Generate one with: openssl rand -base64 32
COURIER_CREDENTIALS_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# Which key the ciphertext was written with, stored on every encrypted row so a rotation
# can find what it still has to re-wrap. `v1` until there is a reason for `v2`.
# COURIER_CREDENTIALS_KEY_ID=v1

# Whether the Steadfast adapter may be used at all (D-006, D-176). Off, and the default is
# the honest one: the adapter was built from the closest thing to first-party documentation
# that could be reached, not from the merchant portal's own API document, so it is marked
# UNVERIFIED in decisions.md. The first person with real credentials turns it on and is
# making a decision when they do.
# COURIER_STEADFAST_ENABLED=false

# Steadfast's API base. Configurable because the two public sources disagree
# (`portal.packzy.com/api/v1` and `portal.steadfast.com.bd/api/v1`) and an operator with a
# portal account can see which one their key belongs to.
# COURIER_STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# How long a courier gets to answer before the job gives up and retries (§20).
# COURIER_HTTP_TIMEOUT_MS=15000

# M16 notifications. The fake gateway records messages and sends nothing; that is the
# default. BulkSMSBD is UNVERIFIED (D-012) and needs both switches, or the API refuses to
# start. Its key and sender id come from the secret manager.
# NOTIFY_SMS_PROVIDER=fake
# NOTIFY_BULKSMSBD_ENABLED=false
# NOTIFY_SMS_TIMEOUT_MS=8000

# M11 public order intake (section 23). Names only; values come from the secret manager.
# Master key that per-site signing secrets derive from. At least 32 characters.
INTAKE_KEY_SECRET=
# Cloudflare Turnstile secret. Without it the intake answers 503 rather than accept unverified forms.
TURNSTILE_SECRET_KEY=
# Test-mode bypass. Refused in production.
INTAKE_TURNSTILE_BYPASS=false
INTAKE_TURNSTILE_TIMEOUT_MS=3000
INTAKE_SIGNATURE_WINDOW_SECONDS=300
INTAKE_RATE_SOURCE_IP_PER_MINUTE=120
INTAKE_RATE_VISITOR_IP_PER_MINUTE=10
INTAKE_RATE_PHONE_PER_HOUR=5
INTAKE_RATE_SITE_PER_MINUTE=300
# `memory` is refused in production: per-process buckets multiply the limit by the replica count.
INTAKE_RATE_LIMIT_STORE=valkey

# M15 couriers. Both adapters are UNVERIFIED (built from the couriers' own plugin code, never
# run against the real service) and stay off until an operator decides otherwise.
COURIER_PATHAO_ENABLED=false
COURIER_PATHAO_BASE_URL=https://api-hermes.pathao.com
COURIER_PATHAO_SANDBOX_BASE_URL=https://courier-api-sandbox.pathao.com
COURIER_PATHAO_TOKEN_PATH=/aladdin/api/v1/external/login
COURIER_PATHAO_DEFAULT_WEIGHT_GRAMS=500
COURIER_REDX_ENABLED=false
COURIER_REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
# No default on purpose: no first-party RedX sandbox host is documented.
# COURIER_REDX_SANDBOX_BASE_URL=
COURIER_REDX_CREATE_PATH=/wordpress/parcel
COURIER_REDX_DEFAULT_WEIGHT_GRAMS=500
