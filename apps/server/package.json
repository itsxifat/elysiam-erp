{
  "name": "@elysium/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "dev": "tsc -b && concurrently -n tsc,api,worker -c blue,green,magenta \"tsc -b --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env --enable-source-maps dist/main.api.js\" \"node --watch --env-file-if-exists=.env --enable-source-maps dist/main.worker.js\"",
    "start:api": "node --env-file-if-exists=.env dist/main.api.js",
    "start:worker": "node --env-file-if-exists=.env dist/main.worker.js",
    "bench:catalog": "node ../../scripts/bench.mjs catalog",
    "bench:fraud": "node ../../scripts/bench.mjs fraud",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@casl/ability": "catalog:",
    "@elysium/config": "workspace:*",
    "@elysium/contracts": "workspace:*",
    "@elysium/db": "workspace:*",
    "@elysium/domain": "workspace:*",
    "@elysium/integrations": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/utils": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "pino-pretty": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
