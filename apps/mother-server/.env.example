# The owner console's server (M32, D-480). Copy to .env (`pnpm setup:env` does).
#
# Local development values only. On the mother's server these come from
# infra/mother/new-env.sh, which writes fresh secrets and never commits them.

NODE_ENV=development
LOG_LEVEL=info

MOTHER_API_HOST=127.0.0.1
MOTHER_API_PORT=3300

# mother_app: the API and the worker's own writes. mother_owner: migrations and the job
# queue. The admin URL is used by `pnpm mother:db:bootstrap` alone (it creates the
# database on the dev stack's Postgres when it is missing, then the two roles).
MOTHER_DATABASE_URL=postgres://mother_app:mother_app_dev_password@localhost:5432/elysium_mother
MOTHER_DATABASE_OWNER_URL=postgres://mother_owner:mother_owner_dev_password@localhost:5432/elysium_mother
MOTHER_DATABASE_ADMIN_URL=postgres://postgres:postgres_dev_password@localhost:5432/postgres

# Where the owner opens the console. In development the Vite server on 5190 proxies the
# API, so the console and the API are one origin, as nginx makes them in production (D-491).
MOTHER_PUBLIC_URL=http://localhost:5190
# Extra origins allowed to write with cookies (comma-separated). Usually empty.
MOTHER_TRUSTED_ORIGINS=

# Signs sessions. A development value; production's comes from new-env.sh.
MOTHER_AUTH_SECRET=dev-only-mother-secret-at-least-32-characters

# AES-256-GCM key for the brands' read connections and owner-link private keys (D-481).
# A development key; never reuse it anywhere else. Generate one with: openssl rand -base64 32
MOTHER_SECRETS_KEY=8oJ0bJh2xC3k5qkYxq0tC8b1mQh6m7P3c2Z9n4R5v8s=
MOTHER_SECRETS_KEY_ID=k1

# Proxies whose X-Forwarded-For is believed: addresses or CIDRs, never a count.
MOTHER_TRUSTED_PROXIES=

# How often the worker reads every brand, and how many recent days each read refreshes.
MOTHER_PULL_EVERY_MINUTES=10
MOTHER_PULL_WINDOW_DAYS=100
