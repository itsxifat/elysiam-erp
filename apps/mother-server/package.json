{
  "name": "@elysium/mother-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/testing",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:generate": "drizzle-kit generate",
    "dev": "tsc -b && concurrently -n tsc,api,worker -c blue,green,magenta \"tsc -b --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env --enable-source-maps dist/main.api.js\" \"node --watch --env-file-if-exists=.env --enable-source-maps dist/main.worker.js\"",
    "start:api": "node --env-file-if-exists=.env --enable-source-maps dist/main.api.js",
    "start:worker": "node --env-file-if-exists=.env --enable-source-maps dist/main.worker.js",
    "mother:db-bootstrap": "node --env-file-if-exists=.env --enable-source-maps dist/main.cli.js db-bootstrap",
    "mother:migrate": "node --env-file-if-exists=.env --enable-source-maps dist/main.cli.js migrate",
    "mother:bootstrap": "node --env-file-if-exists=.env --enable-source-maps dist/main.cli.js bootstrap",
    "mother:people": "node --env-file-if-exists=.env --enable-source-maps dist/main.cli.js people"
  },
  "dependencies": {
    "@better-auth/utils": "catalog:",
    "@elysium/config": "workspace:*",
    "@elysium/db": "workspace:*",
    "@elysium/domain": "workspace:*",
    "@elysium/mother-shared": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "postgres": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
