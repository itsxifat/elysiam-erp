# Copy to .env (`pnpm setup:env` does this for every app).

VITE_API_URL=http://localhost:3000

# Extra connect-src origins for the build's Content-Security-Policy (M14b, D-347), space-separated.
# In production: the R2 upload endpoint, https://<account-id>.r2.cloudflarestorage.com.
# VITE_CSP_CONNECT_SRC=
